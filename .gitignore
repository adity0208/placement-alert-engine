# ============================================
# PLACEMENT ALERT SYSTEM - .gitignore
# ============================================
RESUME_TALKING_POINTS.md
# ==================== Dependencies ====================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# ==================== Environment Variables ====================
# CRITICAL: Never commit these files - they contain secrets!
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ==================== Build Outputs ====================
# Frontend (Vite/React)
frontend/dist/
frontend/build/
frontend/.vite/

# Backend
backend/dist/
backend/build/

# General
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==================== Telegram Session Files ====================
# CRITICAL: Session files contain authentication tokens
*.session
*.session-journal
backend/*.session
backend/session.json

# ==================== IDE & Editor Files ====================
# VSCode
.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==================== OS Files ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ==================== Testing & Coverage ====================
coverage/
*.coverage
.nyc_output/
.cache/
test-results/
playwright-report/

# ==================== Temporary Files ====================
*.tmp
*.temp
.temp/
.tmp/
*.pid
*.seed
*.pid.lock

# ==================== Database Files ====================
# Local database files (if any)
*.db
*.sqlite
*.sqlite3

# MongoDB dumps (if created locally)
dump/
*.bson

# ==================== Deployment & CI/CD ====================
.vercel
.netlify
.render

# ==================== Miscellaneous ====================
# Debug logs
debug.log
error.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache
.parcel-cache

# Next.js build output (if using Next.js)
.next
out

# Nuxt.js build / generate output (if using Nuxt.js)
.nuxt

# Gatsby files (if using Gatsby)
.cache/
public

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

