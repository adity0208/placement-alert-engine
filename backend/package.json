{
  "name": "placement-alert-backend",
  "version": "1.0.0",
  "description": "Real-time placement alert system backend with Telegram integration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate-session": "node scripts/generateSession.js",
    "worker": "node worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand"
  },
  "keywords": ["telegram", "websocket", "placement", "alerts"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.6.0",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^1.3.0",
    "input": "^1.0.1",
    "ioredis": "^5.3.2",
    "mongoose": "^8.1.1",
    "prom-client": "^15.1.2",
    "telegram": "^2.22.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@jest/globals": "^29.7.0",
    "mongodb-memory-server": "^10.0.0"
  }
}
