# Telegram API Credentials
# Get these from https://my.telegram.org/apps
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telegram Session String
# Generate this using: npm run generate-session
SESSION_STRING=your_session_string_here

# Telegram Target Channels/Groups (comma-separated list of group IDs or public handles)
# Get numeric IDs by adding @getidsbot to groups, or use handles directly
# Format: -1001234567890,@react_jobs,placement_updates
TELEGRAM_TARGETS=-1001234567890,@react_jobs

# MongoDB Connection
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/placement-alerts?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# Gemini API Key (Primary AI Parsing)
# Get a free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback AI Parsing for deployment reliability)
# Get a free key from Groq Console: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
