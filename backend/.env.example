# =============================================
# Placement Alert Engine — Backend Environment
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Telegram MTProto Credentials (https://my.telegram.org/apps)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
# SESSION_STRING is generated once via: npm run generate-session
# Keep it secret — it authenticates a real Telegram account.
SESSION_STRING=

# Telegram Target Channels/Groups (comma-separated IDs or handles)
TELEGRAM_TARGETS=-1001234567890,@example_channel

# MongoDB Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/placement-alerts?retryWrites=true&w=majority

# Backend Port
PORT=5000

# Primary AI Provider (https://aistudio.google.com)
GEMINI_API_KEY=

# Secondary Failover AI Provider (https://console.groq.com)
GROQ_API_KEY=

# Redis (local: redis://localhost:6379 | Docker: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# BullMQ worker concurrency
BULL_CONCURRENCY=3

# Node environment
NODE_ENV=development
